{
  "name": "plakar-ui",
  "private": true,
  "version": "1.0.0",
  "author": "Julien Castets",
  "type": "module",
  "license": "ISC",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "turbo run dev --ui=tui",
    "check": "pnpm run check-dedupe && turbo run lint check-ts check-format test",
    "check-dedupe": "pnpm dedupe --check",
    "check-format": "prettier --check .",
    "format": "prettier --write \"**/*.{html,ts,tsx,md,json}\"",
    "check-knip": "knip",
    "preview": "turbo run preview",
    "build": "turbo run build",
    "test": "turbo run test"
  },
  "devDependencies": {
    "knip": "^6.41.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.9"
  },
  "pnpm": {
    "overrides": {
      "refractor>prismjs": "^1.30.0"
    },
    "patchedDependencies": {
      "mdast-util-gfm-table": "patches/mdast-util-gfm-table.patch",
      "refractor": "patches/refractor.patch"
    }
  }
}
